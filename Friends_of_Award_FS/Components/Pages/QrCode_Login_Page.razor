@page "/qr-login"
@rendermode InteractiveServer
@using Blazor_WithAuth_ForSWP5
@using Friends_of_Award_FS_Lib
@inject NavigationManager MyNavMgr
@inject MyCustomAuthStateProvider? MyAuthStateProvider

<h3>QrCode_Login_Page</h3>

@if (!string.IsNullOrEmpty(error))
{
    <p style="color:red">@error</p>
}



@code {
    private string? token;
    private string? error = "";
    private bool tokenIsInvalid = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var uri = MyNavMgr.ToAbsoluteUri(MyNavMgr.Uri);

        Console.WriteLine($"[QR LOGIN] URL = {uri}");
        

        if (!Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query)
            .TryGetValue("token", out var token))
        {
            error = "No token found.";
            Console.WriteLine($"[QR LOGIN] No token found");
            StateHasChanged();
            return;
        }

        Console.WriteLine($"[QR LOGIN] Token received = {token}");
        var valid = Token.IsValidUnusedToken(token);

        if (!valid)
        {
            error = "Invalid token.";
            StateHasChanged();
            return;
        }

        MyAuthStateProvider.Login(token);
        MyNavMgr.NavigateTo("/");
    }

}
