@page "/"

@rendermode InteractiveServer

@using Blazor_WithAuth_ForSWP5
@using Friends_of_Award_FS_Lib.Services
@using Microsoft.AspNetCore.Components.Authorization

@inject MyCustomAuthStateProvider? MyAuthStateProvider
@inject NavigationManager MyNavMgr
@inject DiplomarbeitenService DaService
@inject TokenService TokenService
@inject VotingConfigService VotingConfig

<PageTitle>Home</PageTitle>


<AuthorizeView>
    <Authorized>
        <div class="page-wrapper">
            <h1 class="title-main">Friends of Award</h1>

            <p class="subtitle">
                Geben Sie uns Ihre persönlichen Favoriten bekannt!
            </p>

            <p class="instructions">
                Einfacher Klick = Favorit (max. 5)<br />
                Doppelklick = Topfavorit (max. 1)
            </p>

            <p class="note-text">
                Diese Abstimmung ist anonym und auf ein Gerät beschränkt!
            </p>

            <div class="button-grid">
                @foreach ((int nr, string titel) in diplomarbeiten)
                {
                    <button class="number-button @(GetButtonClass(nr)) lp-target"
                            title="@titel"
                            @onpointerdown="() => OnPressStart(titel)"
                            @onpointerup="OnPressEnd"
                            @onpointercancel="OnPressEnd"
                            @onpointerleave="OnPressEnd"
                            @onclick="() => ClickButton(nr)"
                            @ondblclick="() => DoubleClickButton(nr)"
                            disabled="@(!VotingConfig.IsVotingOpen())">
                        @GetStars(nr) @nr
                    </button>
                }
            </div>
            @if (showLongPressTitle)
            {
                <div class="lp-tooltip">@longPressTitle</div>
            }

            <p class="status">
                Offen: @remainingFavorites Favoriten, @remainingTopFavorite Topfavorit
            </p>

            <div class="submit-container">
                <button class="submit-button" @onclick="Btn_BewertungAbsenden" disabled="@(!VotingConfig.IsVotingOpen())">
                    Bewertung absenden
                </button>
            </div>
            @if (!VotingConfig.IsVotingOpen())
            {
                <p class="error-text">
                    ⛔ Die Abstimmung ist bereits beendet.
                </p>
            }

            @if (hasSubmitted)
            {
                @switch (status)
                {
                    case Status.Success:
                        <p class="success-text">
                            ✅ Vielen Dank! Ihre Bewertung wurde gespeichert.
                        </p>
                        break;

                    case Status.AlreadyVoted:
                        <p class="error-text">
                            ⚠️ Sie haben bereits abgestimmt. Mehrfaches Abstimmen ist nicht erlaubt.
                        </p>
                        break;

                    case Status.NothingSelected:
                        <p class="error-text">
                            ⚠️ Bitte wählen Sie mindestens einen Favoriten oder einen Topfavoriten aus.
                        </p>
                        break;

                    case Status.VotingClosed:
                        <p class="error-text">
                            ⛔ Die Abstimmung ist bereits beendet.
                        </p>
                        break;

                    case Status.OtherError:
                        <p class="error-text">
                            ❌ Fehler beim Speichern der Bewertung.
                        </p>
                        break;
                }
            }
        </div>

    </Authorized>

    <NotAuthorized>
        <p>Weiterleitung...</p>
    </NotAuthorized>
</AuthorizeView>


@code {
    private List<(int, string)> diplomarbeiten = new();

    private int MaxFavorites = 5;
    private HashSet<int> favorites = new();
    private int? topFavorite = null;

    private int remainingFavorites => MaxFavorites - favorites.Count;
    private int remainingTopFavorite => topFavorite == null ? 1 : 0;

    private bool success;
    private Status status;
    private bool hasSubmitted = false;
    private bool isAllowedToVote = false;
    private bool isVotingOpen;




    protected override void OnInitialized()
    {
        diplomarbeiten = LoadDiplomarbeiten();
        isVotingOpen = VotingConfig.IsVotingOpen();
    }

    private List<(int, string)> LoadDiplomarbeiten()
    {
        return DaService.GetDiplomarbeitForVoting();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var uri = MyNavMgr.ToAbsoluteUri(MyNavMgr.Uri);

        Console.WriteLine($"[HOME] URL: {uri}");
        Console.WriteLine($"[HOME] HasToken: {uri.Query.Contains("token")}");

        // Wenn Token vorhanden → Home greift NICHT ein
        if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query)
            .TryGetValue("token", out var tokenValue))
        {
            MyNavMgr.NavigateTo($"/qr-login?token={tokenValue}");
            return;
        }

        // Nur normaler Auth-Check OHNE Token
        var state = await MyAuthStateProvider.GetAuthenticationStateAsync();
        var user = state.User;

        if (!user.Identity!.IsAuthenticated)
        {
            MyNavMgr.NavigateTo("/adminlogin", true);
        }
    }

    private void Logout()
    {
        MyAuthStateProvider.Logout();
        MyNavMgr.NavigateTo("/");
    }




    private bool IsFavorite(int id) => favorites.Contains(id);
    private bool IsTopFavorite(int id) => topFavorite == id;


    private string GetButtonClass(int id)
        => IsTopFavorite(id) ? "topfavorite"
         : IsFavorite(id) ? "favorite"
         : "";

    private string GetStars(int id)
        => IsTopFavorite(id) ? "⭐⭐ "
         : IsFavorite(id) ? "⭐ "
         : "";

    private void ClickButton(int id)
    {
        if (!VotingConfig.IsVotingOpen()) return;
        if (IsTopFavorite(id)) return;

        if (IsFavorite(id))
        {
            favorites.Remove(id);
            return;
        }

        if (favorites.Count >= MaxFavorites) return;

        favorites.Add(id);
    }

    private void DoubleClickButton(int id)
    {
        if (!VotingConfig.IsVotingOpen()) return;
        if (IsTopFavorite(id))
        {
            topFavorite = null;
            return;
        }

        topFavorite = id;
        favorites.Remove(id);
    }


    private async Task Btn_BewertungAbsenden()
    {
        hasSubmitted = true;

        if (!VotingConfig.IsVotingOpen())
        {
            status = Status.VotingClosed;
            return;
        }

        var state = await MyAuthStateProvider.GetAuthenticationStateAsync();
        var username = state.User.Identity?.Name;

        if (!string.IsNullOrEmpty(username))
        {
            isAllowedToVote = TokenService.IsUserAllowedToVote(username);
        }
        else
        {
            return;
        }

        if (!isAllowedToVote)
        {
            status = Status.AlreadyVoted;
            return;
        }


        if (favorites.Count < 1 && topFavorite == null)
        {
            status = Status.NothingSelected;
            return;
        }
        success = DaService.SendVote(favorites, topFavorite);
        if (success)
        {
            status = Status.Success;
            TokenService.MarkAsVoted(username);
            favorites.Clear();
            topFavorite = null;
        }
        else
        {
            status = Status.OtherError;
        }

    }


    private bool showLongPressTitle = false;
    private string longPressTitle = "";
    private CancellationTokenSource? longPressCts;

    private void OnPressStart(string title)
    {
        // wenn Voting zu: optional trotzdem anzeigen oder return
        // if (!VotingConfig.IsVotingOpen()) return;

        longPressCts?.Cancel();
        longPressCts = new CancellationTokenSource();
        var token = longPressCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(600, token); // Longpress-Dauer
                longPressTitle = title;
                showLongPressTitle = true;
                await InvokeAsync(StateHasChanged);
            }
            catch (TaskCanceledException) { }
        });
    }

    private void OnPressEnd()
    {
        longPressCts?.Cancel();
        showLongPressTitle = false;
    }



    enum Status
    {
        Success,
        AlreadyVoted,
        NothingSelected,
        VotingClosed,
        OtherError
    }
}
