<h3>Willkommen</h3>

<h1 class="title-main">Friends of Award</h1>

<p class="subtitle">
    Geben Sie uns Ihre persönlichen Favoriten bekannt!
</p>

<p class="instructions">
    Einfacher Klick = Favorit (max. 5)<br />
    Doppelklick = Topfavorit (max. 1)
</p>

<p class="note-text">
    Diese Abstimmung ist anonym und auf ein Gerät beschränkt!
</p>

<div class="button-grid">
    @foreach ((int nr, string titel) in diplomarbeiten)
    {
        <button class="number-button @(GetButtonClass(nr))"
                title="@titel"
                @onclick="() => ClickButton(nr)"
                @ondblclick="() => DoubleClickButton(nr)">
            @GetStars(nr) @nr
        </button>
    }
</div>

<p class="status">
    Offen: @remainingFavorites Favoriten, @remainingTopFavorite Topfavorit
</p>

<div class="submit-container">
    <button class="submit-button" @onclick="Btn_BewertungAbsenden">
        Bewertung absenden
    </button>
</div>


@if (hasSubmitted)
{
    if (success)
    {
        <p class="success-text">✅ Vielen Dank! Ihre Bewertung wurde gespeichert.</p>
    }
    else if (!success)
    {
        <p class="error-text">❌ Fehler beim Speichern der Bewertung.</p>
    }
}



@code {
    private List<(int, string)> diplomarbeiten = new();

    private int MaxFavorites = 5;
    private HashSet<int> favorites = new();
    private int? topFavorite = null;

    private int remainingFavorites => MaxFavorites - favorites.Count;
    private int remainingTopFavorite => topFavorite == null ? 1 : 0;

    private bool success;
    private bool hasSubmitted = false;




    protected override void OnInitialized()
    {
        diplomarbeiten = LoadDiplomarbeiten();
    }

    private List<(int, string)> LoadDiplomarbeiten()
    {
        return DaService.GetDiplomarbeitForVoting();
    }

