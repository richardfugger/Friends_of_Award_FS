    private void Logout()
    {
        ((MyCustomAuthStateProvider)MyAuthStateProvider).Logout();
        MyNavMgr.NavigateTo("/");
    }




    private bool IsFavorite(int id) => favorites.Contains(id);
    private bool IsTopFavorite(int id) => topFavorite == id;


    private string GetButtonClass(int id)
        => IsTopFavorite(id) ? "topfavorite"
         : IsFavorite(id) ? "favorite"
         : "";

    private string GetStars(int id)
        => IsTopFavorite(id) ? "⭐⭐ "
         : IsFavorite(id) ? "⭐ "
         : "";

    private void ClickButton(int id)
    {
        if (IsTopFavorite(id)) return;

        if (IsFavorite(id))
        {
            favorites.Remove(id);
            return;
        }

        if (favorites.Count >= MaxFavorites) return;

        favorites.Add(id);
    }

    private void DoubleClickButton(int id)
    {
        if (IsTopFavorite(id))
        {
            topFavorite = null;
            return;
        }

        topFavorite = id;
        favorites.Remove(id);
    }


    private void Btn_BewertungAbsenden()
    {
        hasSubmitted = true;

        if (favorites.Count < 1 && topFavorite == null)
        {
            success = false;
        }
        success = DaService.SendVote(favorites, topFavorite);
        if (success)
        {
            favorites.Clear();
            topFavorite = null;
        }
    }

}
