@page "/"
@rendermode InteractiveServer
@using Blazor_WithAuth_ForSWP5
@using Microsoft.AspNetCore.Components.Authorization
@inject MyCustomAuthStateProvider? MyAuthStateProvider
@inject NavigationManager MyNavMgr

<PageTitle>Home</PageTitle>

<AuthorizeView>
    <Authorized>
        <h3>Willkommen</h3>
        
    </Authorized>

    <NotAuthorized>
        <p>Weiterleitung...</p>
    </NotAuthorized>
</AuthorizeView>

<h1 class="title-main">Friends of Award</h1>

<p class="subtitle">
    Geben Sie uns Ihre persönlichen Favoriten bekannt!
</p>

<p class="instructions">
    Einfacher Klick = Favorit (max. 5)<br />
    Doppelklick = Topfavorit (max. 1)
</p>

<p class="note-text">
    Diese Abstimmung ist anonym und auf ein Gerät beschränkt!
</p>

<div class="button-grid">
    @foreach (var da in Diplomarbeiten)
    {
        <button class="number-button @(GetButtonClass(da.Id))"
                title="@da.Titel"
                @onclick="() => ClickButton(da.Id)"
                @ondblclick="() => DoubleClickButton(da.Id)">
            @GetStars(da.Id) @da.Id
        </button>
    }
</div>

<p class="status">
    Offen: @RemainingFavorites Favoriten, @RemainingTop Topfavorit
</p>

<div class="submit-container">
    <button class="submit-button">
        Bewertung absenden
    </button>
</div>

@*if (showAdmin)
{
    <div class="admin-panel">
        <h2 class="admin-title">Adminbereich</h2>

        <div class="admin-row">
            <label for="adminCode">Admin-Code:</label>
            <input id="adminCode" type="password" @bind="adminCode" />

            <button @onclick="OnLogin">Anmelden</button>
            <button @onclick="OnLogout">Abmelden</button>
        </div>
    </div>
}*@

<button class="home-button" @onclick="ToggleAdmin">
    🏠
</button>

<style>
    body {
        font-family: Arial;
    }
</style>

@code {
    void Btn_Login() => MyNavMgr.NavigateTo("/Login");

    void Btn_Logout()
    {
        MyAuthStateProvider?.Logout();
    }

    public class DiplomarbeitInfo
    {
        public int Id { get; set; }
        public string Titel { get; set; } = string.Empty;
    }

    private List<string> Diplomarbeitstitel = new()
    {
        "Smart Home Monitoring System",
        "KI-gestützte Bildauswertung",
        "Mobile App für Schulorganisation",
        "IoT Energieverbrauchsanalyse",
        "Webplattform Event-Management",
        "Autonomes Robotikfahrzeug",
        "E-Learning Portal",
        "3D-Drucker Monitoring",
        "Smart Garden",
        "Chatbot Schul-FAQ",
        "RFID Zeiterfassung",
        "VR Physik Lernapp",
        "Coding Lernplattform",
        "Ticket-System Schule",
        "Smart Locker System",
        "Verkehrsanalyse KI",
        "Fitness Tracker BLE",
        "Online-Abstimmungssystem",
        "Raumbelegungsanzeige"
    };

    public List<DiplomarbeitInfo> Diplomarbeiten { get; set; } = new();

    protected override void OnInitialized()
    {
        int idCounter = 1;
        foreach (var titel in Diplomarbeitstitel)
        {
            Diplomarbeiten.Add(new DiplomarbeitInfo
            {
                Id = idCounter++,
                Titel = titel
            });
        }
    }

    private int MaxFavorites = 5;
    private HashSet<int> favorites = new();
    private int? topfavorite = null;

    private int RemainingFavorites => MaxFavorites - favorites.Count;
    private int RemainingTop => topfavorite == null ? 1 : 0;

    private bool IsFavorite(int id) => favorites.Contains(id);
    private bool IsTopFavorite(int id) => topfavorite == id;

    private string GetButtonClass(int id)
        => IsTopFavorite(id) ? "topfavorite"
         : IsFavorite(id) ? "favorite"
         : "";

    private string GetStars(int id)
        => IsTopFavorite(id) ? "⭐⭐ "
         : IsFavorite(id) ? "⭐ "
         : "";

    private void ClickButton(int id)
    {
        if (IsTopFavorite(id)) return;

        if (IsFavorite(id))
        {
            favorites.Remove(id);
            return;
        }

        if (favorites.Count >= MaxFavorites) return;

        favorites.Add(id);
    }

    private void DoubleClickButton(int id)
    {
        if (IsTopFavorite(id))
        {
            topfavorite = null;
            return;
        }

        topfavorite = id;
        favorites.Remove(id);
    }

    private bool showAdmin = false;
    private string adminCode = string.Empty;

    private void ToggleAdmin() => showAdmin = !showAdmin;

    private void OnLogin()
    {
        Console.WriteLine($"Login mit Code: {adminCode}");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var uri = MyNavMgr.ToAbsoluteUri(MyNavMgr.Uri);

        Console.WriteLine($"[HOME] URL: {uri}");
        Console.WriteLine($"[HOME] HasToken: {uri.Query.Contains("token")}");

        // 🔴 WICHTIG: Wenn Token vorhanden → Home greift NICHT ein
        if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query)
            .TryGetValue("token", out var tokenValue))
        {
            MyNavMgr.NavigateTo($"/qr-login?token={tokenValue}");
            return;
        }

        // 🔹 Nur normaler Auth-Check OHNE Token
        var state = await MyAuthStateProvider.GetAuthenticationStateAsync();
        var user = state.User;

        if (!user.Identity!.IsAuthenticated)
        {
            MyNavMgr.NavigateTo("/adminlogin", true);
        }
    }

    private void Logout()
    {
        ((MyCustomAuthStateProvider)MyAuthStateProvider).Logout();
        MyNavMgr.NavigateTo("/");
    }
}
