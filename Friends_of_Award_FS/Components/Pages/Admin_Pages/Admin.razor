@page "/admin"
@using Blazor_WithAuth_ForSWP5
@using Friends_of_Award_FS.Components.Layout
@layout AdminLayout
@rendermode InteractiveServer
@inject MyCustomAuthStateProvider MyAuthStateProvider
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager MyNavMgr

<h2>Dashboard</h2>

<AuthorizeView>
    <Authorized>
        @{
            string name = "unknown";
            if (context.User.Identity != null)
            {
                name = context.User.Identity.Name ?? "unknown";
            }
        }

        <div class="admin-wrapper">
            <div class="admin-card">
                <h3>🔐 Admin Bereich</h3>
                <p class="welcome">
                    Willkommen im Admin-Bereich, <strong>@name</strong>!
                </p>
            </div>
        </div>
    </Authorized>

    <NotAuthorized>
        <p>Weiterleitung</p>
    </NotAuthorized>
</AuthorizeView>



