@page "/admin/import"

@rendermode InteractiveServer

@using Blazor_WithAuth_ForSWP5
@using Friends_of_Award_FS.Components.Layout
@using Friends_of_Award_FS_Lib.Services
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Authorization

@inject NavigationManager MyNavMgr
@inject MyCustomAuthStateProvider? MyAuthStateProvider
@inject DiplomarbeitenService DaService

@layout AdminLayout



<AuthorizeView>
    <Authorized>
        <div class="import-page">

            <div class="import-card">
                <div class="import-icon">📥</div>

                <h2>Diplomarbeiten importieren</h2>
                <p class="import-description">
                    Lade eine Excel-Datei hoch, um die bestehende Liste zu ersetzen.
                </p>

                <div class="import-hint">
                    Erwartete Spalten: <b>Nr | AbteilungKürzel | Titel | Autor:innen</b><br />
                    Erlaubte Kürzel: MB, ME, WII, WIE, GT
                </div>

                <div class="import-warning">
                    ⚠️ Achtung: Beim Import werden alle bestehenden Einträge überschrieben!
                </div>

                <form enctype="multipart/form-data" class="file-upload">
                    <InputFile id="excelUpload"
                               OnChange="OnFileSelected"
                               accept=".xlsx"
                               style="display:none" />

                    <label for="excelUpload" class="file-button">
                        📂 Excel-Datei auswählen
                    </label>

                    @if (!string.IsNullOrEmpty(SelectedFileName))
                    {
                        <div class="file-name">Ausgewählt: @SelectedFileName</div>
                    }


                </form>

                @if (!string.IsNullOrEmpty(Status))
                {
                    <div class="import-status">@Status</div>
                }

                @if (Errors.Count > 0)
                {
                    <ul class="import-errors">
                        @foreach (var e in Errors)
                        {
                            <li>@e</li>
                        }
                    </ul>
                }

                @if (ShowConfirm)
                {
                    <div class="modal-backdrop">
                        <div class="modal-card">
                            <h3>⚠️ Import bestätigen</h3>

                            <p>
                                Soll die Datei <b>@SelectedFileName</b> wirklich importiert werden?
                            </p>
                            <p>
                                <b>Alle bestehenden Einträge werden überschrieben!</b>
                            </p>

                            <div class="modal-actions">
                                <button class="file-button" @onclick="ConfirmImport">
                                    ✅ Ja, importieren
                                </button>

                                <button class="cancel-button" @onclick="CancelImport">
                                    ❌ Abbrechen
                                </button>
                            </div>
                        </div>
                    </div>
                }

            </div>

        </div>
    </Authorized>

    <NotAuthorized>
        <p>Weiterleitung...</p>
    </NotAuthorized>
</AuthorizeView>


@code {
    List<string> Errors = new();
    string? SelectedFileName;

    string? Status;

    IBrowserFile? SelectedFile;
    bool ShowConfirm = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var uri = MyNavMgr.ToAbsoluteUri(MyNavMgr.Uri);

        var state = await MyAuthStateProvider.GetAuthenticationStateAsync();
        var user = state.User;

        if (!user.Identity!.IsAuthenticated)
        {
            MyNavMgr.NavigateTo("/adminlogin", true);
        }
    }

    async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        SelectedFile = e.File;
        SelectedFileName = e.File.Name;

        ShowConfirm = true;
        Status = null;
        Errors.Clear();
    }

    async Task ConfirmImport()
    {
        if (SelectedFile == null)
            return;

        Status = "Import läuft...";
        Errors.Clear();

        try
        {
            await using var uploadStream = SelectedFile.OpenReadStream(10 * 1024 * 1024);
            using var ms = new MemoryStream();

            await uploadStream.CopyToAsync(ms);
            ms.Position = 0;

            var result = DaService.ImportAndReplace(ms);

            Errors = result.errors;
            Status = Errors.Count == 0
                ? $"Import erfolgreich ({result.imported} Einträge)."
                : "Import fehlgeschlagen.";
        }
        catch (Exception ex)
        {
            Status = "Fehler beim Import.";
            Errors.Add(ex.Message);
        }
        finally
        {
            ShowConfirm = false;
        }

    }

    void CancelImport()
    {
        SelectedFile = null;
        SelectedFileName = null;
        ShowConfirm = false;
        Status = "Import abgebrochen.";
    }

}
