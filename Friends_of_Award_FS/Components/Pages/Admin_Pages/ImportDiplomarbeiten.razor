@page "/admin/import"

@rendermode InteractiveServer

@using Blazor_WithAuth_ForSWP5
@using Friends_of_Award_FS.Components.Layout
@using Friends_of_Award_FS_Lib.Services
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Authorization

@inject NavigationManager MyNavMgr
@inject MyCustomAuthStateProvider? MyAuthStateProvider
@inject DiplomarbeitenService DaService

@layout AdminLayout



<AuthorizeView>
    <Authorized>
        <div class="import-page">

            <div class="import-card">
                <div class="import-icon">📥</div>

                <h2>Diplomarbeiten importieren</h2>
                <p class="import-description">
                    Lade eine Excel-Datei hoch, um die bestehende Liste zu ersetzen.
                </p>

                <div class="import-hint">
                    Erwartete Spalten: <b>Nr | AbteilungKürzel | Titel | Autor:innen</b><br />
                    Erlaubte Kürzel: MB, ME, WII, WIE, GT
                </div>

                <div class="import-warning">
                    ⚠️ Achtung: Beim Import werden alle bestehenden Einträge überschrieben!
                </div>

                <form enctype="multipart/form-data" class="file-upload">
                    <InputFile id="excelUpload"
                               OnChange="OnFileSelected"
                               accept=".xlsx"
                               class="file-input" />

                    <label for="excelUpload" class="file-button">
                        📂 Excel-Datei auswählen
                    </label>

                    @if (!string.IsNullOrEmpty(SelectedFileName))
                    {
                        <div class="file-name">Ausgewählt: @SelectedFileName</div>
                    }
                </form>

                @if (!string.IsNullOrEmpty(Status))
                {
                    <div class="import-status">@Status</div>
                }

                @if (Errors.Count > 0)
                {
                    <ul class="import-errors">
                        @foreach (var e in Errors)
                        {
                            <li>@e</li>
                        }
                    </ul>
                }
            </div>

        </div>
    </Authorized>

    <NotAuthorized>
        <p>Weiterleitung...</p>
    </NotAuthorized>
</AuthorizeView>


@code {
    string? Status;
    List<string> Errors = new();
    string? SelectedFileName;

    async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        SelectedFileName = e.File.Name;

        Console.WriteLine("[Import Page] Method enetred");

        Errors.Clear();
        Status = "Import läuft...";

        try
        {
            await using var uploadStream = e.File.OpenReadStream(10 * 1024 * 1024);
            using var ms = new MemoryStream();

            await uploadStream.CopyToAsync(ms);
            ms.Position = 0;

            var result = DaService.ImportAndReplace(ms);

            Errors = result.errors;
            Status = Errors.Count == 0
                ? $"Import erfolgreich ({result.imported} Einträge)."
                : "Import fehlgeschlagen.";
        }
        catch (Exception ex)
        {
            Status = "Fehler beim Import.";
            Errors.Add(ex.Message);
        }
    }

